# ---------------------------------------------------------------------------
# Configuração do frontend Quero Trabalhar
# Copie para .env  ->  cp .env.example .env
# ---------------------------------------------------------------------------

# Para onde o dev server (vite) encaminha /login e /api.
# Use o endereço em que a API Spring Boot está rodando.
#   - API rodando direto na máquina:      http://localhost:8080
#   - API rodando em container (compose): http://quero-trabalhar-api:8080
VITE_API_PROXY_TARGET=http://localhost:8080

# Prefixo aplicado a toda requisição feita pelo src/api/client.js.
# Deixe VAZIO para usar o proxy (recomendado: mesma origem, sem CORS).
# Preencha apenas se quiser chamar o backend diretamente do navegador —
# nesse caso a API precisa liberar esta origem em CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
