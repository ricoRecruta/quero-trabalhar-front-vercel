FROM node:22-alpine AS web-build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json

RUN npm ci

COPY apps/web ./apps/web

RUN npm run build --workspace @quero-trabalhar/web

FROM maven:3.9.9-eclipse-temurin-21 AS api-build

WORKDIR /app

COPY apps/api/pom.xml ./pom.xml
COPY apps/api/src ./src
COPY --from=web-build /workspace/apps/web/dist ./src/main/resources/static

RUN mvn -q -DskipTests clean package

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=api-build /app/target/*.jar app.jar

ENV SPRING_PROFILES_ACTIVE=prod
ENV SERVER_FORWARD_HEADERS_STRATEGY=framework

EXPOSE 8080

CMD ["sh", "-c", "java -Dserver.port=${PORT:-8080} -jar app.jar"]
