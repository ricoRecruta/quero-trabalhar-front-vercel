{
  "name": "quero-trabalhar-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @quero-trabalhar/web",
    "dev:web": "npm run dev --workspace @quero-trabalhar/web",
    "dev:api": "mvn -f apps/api/pom.xml spring-boot:run",
    "build": "npm run build --workspace @quero-trabalhar/web",
    "build:web": "npm run build --workspace @quero-trabalhar/web",
    "build:api": "mvn -f apps/api/pom.xml -DskipTests package",
    "lint": "npm run lint --workspace @quero-trabalhar/web",
    "test:api": "mvn -f apps/api/pom.xml test"
  }
}
